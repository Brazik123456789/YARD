# ============================================================
# Yard — example environment configuration
# Copy to .env for local development.
# NEVER commit real secrets.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=local
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:5173

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yard
POSTGRES_USER=yard
POSTGRES_PASSWORD=change_me

# Optional JDBC form if preferred by Spring configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/yard
SPRING_DATASOURCE_USERNAME=yard
SPRING_DATASOURCE_PASSWORD=change_me

# ------------------------------------------------------------
# Redis / Queue
# Enable only when introduced by implementation plan.
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=yard
# RABBITMQ_PASSWORD=change_me

# ------------------------------------------------------------
# Yandex Worker / Playwright
# ------------------------------------------------------------
YANDEX_WORKER_ENABLED=true

# Directory for encrypted/local browser session state.
# Do not place session files inside git-tracked directories.
YANDEX_SESSION_STATE_DIR=./runtime/yandex-sessions

# Browser can be headed during manual login / PoC.
YANDEX_BROWSER_HEADLESS=false

# Poll interval is only a PoC/config value.
# Real production value must be chosen from measurements.
YANDEX_REVIEW_POLL_INTERVAL_SECONDS=900

# ------------------------------------------------------------
# Google Business Profile
# Fill only after API access is approved.
# ------------------------------------------------------------
GOOGLE_BUSINESS_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ------------------------------------------------------------
# 2GIS
# Connector details are not fixed yet.
# ------------------------------------------------------------
TWOGIS_ENABLED=false
TWOGIS_SESSION_STATE_DIR=./runtime/2gis-sessions

# ------------------------------------------------------------
# AI
# Do not commit actual keys.
# ------------------------------------------------------------
YANDEX_AI_ENABLED=false
YANDEX_AI_API_KEY=
YANDEX_AI_FOLDER_ID=

# ------------------------------------------------------------
# Payments / YooKassa
# Not required for M0.
# ------------------------------------------------------------
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Telegram
# Not required for M0.
# ------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# ------------------------------------------------------------
# MAX
# Not required for M0.
# ------------------------------------------------------------
MAX_ENABLED=false
MAX_BOT_TOKEN=

# ------------------------------------------------------------
# Security
# Generate real values locally/production.
# ------------------------------------------------------------
APP_ENCRYPTION_KEY=change_me
JWT_SECRET=change_me

# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------
MANAGEMENT_ENDPOINTS_ENABLED=false
